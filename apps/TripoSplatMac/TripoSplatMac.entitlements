<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Sandbox off: the app spawns the Python Core AI backend (Process) and reads/writes
         user-chosen image + temp .ply paths. Fine for local/dev use. -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
</dict>
</plist>
